// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  mobile     String?  @db.VarChar(20)
  role       String   @default("USER") @db.VarChar(20) // "USER" or "ADMIN"
  planId       Int?
  planStatus   String   @default("INACTIVE") @db.VarChar(20) // "INACTIVE", "ACTIVE", or "EXPIRED"
  planExpiresAt DateTime?
  address    String?  @db.Text
  country    String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  gender     String?  @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  status     String   @default("ACTIVE") @db.VarChar(20) // "ACTIVE", "INACTIVE", "BANNED"
  forms      Form[]
  plan       Plan?    @relation(fields: [planId], references: [id])
  fieldTemplateAssignments UserFieldTemplate[]

  @@map("users")
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(255)
  price       Int
  period      String   @db.VarChar(50)
  features    Json     // Array of features
  formLimit   Int      // -1 for unlimited
  entryLimit  Int      // -1 for unlimited
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]

  @@map("plans")
}

model Form {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  fields      Json     // Array of field definitions: [{ name, label, type, required, options }]
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@map("forms")
}

model Entry {
  id        Int      @id @default(autoincrement())
  data      Json     // Key-value pairs matching form fields
  formId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("entries")
}

model RegistrationRequest {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  mobile    String?  @db.VarChar(20)
  address   String?  @db.Text
  country   String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  gender    String?  @db.VarChar(20)
  planId    Int?     // Admin assigns plan during approval
  status    String   @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED
  adminNote String?  @db.Text // Admin can add a note when approving/rejecting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("registration_requests")
}

// Admin creates field templates (sets of up to 12 fields)
model AdminFieldTemplate {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  fields      Json     // Array: [{ id, label, placeholder, type, required }] — up to 12
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserFieldTemplate[]

  @@map("admin_field_templates")
}

// Junction table: which templates are assigned to which users
model UserFieldTemplate {
  id         Int      @id @default(autoincrement())
  userId     Int
  templateId Int
  assignedAt DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template AdminFieldTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId]) // Prevent duplicate assignments
  @@map("user_field_templates")
}

model AdminFormTemplate {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  fields      Json     // Array of field definitions: [{ name, label, type, required, options }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_form_templates")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("settings")
}
